{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "devCommand": "npm run dev",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.casadeljaguariquitos.com" }],
      "destination": "https://casadeljaguariquitos.com/:path*",
      "permanent": true
    },
    { "source": "/sobre-nosotros", "destination": "/about/", "permanent": true },
    { "source": "/sobre-nosotros/", "destination": "/about/", "permanent": true },
    { "source": "/es", "destination": "/", "permanent": true },
    { "source": "/es/", "destination": "/", "permanent": true },
    { "source": "/es/:path*", "destination": "/:path*", "permanent": true },
    {
      "source": "/aweking-to-the-divine-inaugural-encounter-with-mother-ayahuasca",
      "destination": "/awakening-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "permanent": true
    },
    {
      "source": "/aweking-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "destination": "/awakening-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "permanent": true
    },
    {
      "source": "/en/aweking-to-the-divine-inaugural-encounter-with-mother-ayahuasca",
      "destination": "/en/awakening-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "permanent": true
    },
    {
      "source": "/en/aweking-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "destination": "/en/awakening-to-the-divine-inaugural-encounter-with-mother-ayahuasca/",
      "permanent": true
    },
    {
      "source": "/((?!api/)(?!_astro/)(?!.*\\.).+[^/])",
      "destination": "/$1/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
