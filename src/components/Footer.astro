---
import { getLangFromUrl, useTranslations, translatePath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const footerContent = {
  es: {
    mainMenu: "Menú Principal",
    help: "Ayuda",
    callToday: "Llama Hoy",
    newsletter: "Suscríbete",
    mainMenuLinks: [
      { href: '/', label: 'Inicio' },
      { href: '/casa-del-jaguar-way', label: 'La Experiencia' },
      { href: '/ayahuasca-ceremonies', label: 'Ceremonias de Ayahuasca' },
      { href: '/excursions', label: 'Excursiones Amazónicas' },
      { href: '/resort', label: 'Centro Ceremonial' },
      { href: '/about', label: 'Nuestra Historia' },
      { href: '/testimonials', label: 'Testimonios' },
      { href: '/blog', label: 'Blog' }
    ],
    helpLinks: [
      { href: '/booking', label: 'Reservar Ahora' },
      { href: '/pricing', label: 'Precios' },
      { href: '/calendar', label: 'Calendario' },
      { href: '/contact', label: 'Contáctanos' },
      { href: '/faqs', label: 'Preguntas Frecuentes' },
      { href: '/diet', label: 'Dieta' },
      { href: '/safety', label: 'Seguridad' },
      { href: '/cancellation', label: 'Cancelación' },
      { href: '/how-to-prepare-for-ayahuasca-ceremony-complete-guide', label: 'Guía de Preparación' }
    ],
    businessHours: {
      weekdays: "Lunes–Viernes:",
      weekend: "Sábado–Domingo:"
    },
    newsletterForm: {
      firstName: "Nombre",
      lastName: "Apellido",
      email: "Correo Electrónico",
      consent: "Acepto recibir correos de marketing y acepto los",
      terms: "Términos",
      privacy: "Política de Privacidad",
      subscribe: "Suscribirse"
    },
    copyright: "© 2025 Casa del Jaguar. Todos los derechos reservados.",
    legal: {
      terms: "Términos de Servicio",
      privacy: "Política de Privacidad"
    }
  },
  en: {
    mainMenu: "Main Menu",
    help: "Help",
    callToday: "Call Today",
    newsletter: "Newsletter Sign-Up",
    mainMenuLinks: [
      { href: '/en/', label: 'Home' },
      { href: '/en/casa-del-jaguar-way', label: 'The Experience' },
      { href: '/en/ayahuasca-ceremonies', label: 'Ayahuasca Ceremonies' },
      { href: '/en/excursions', label: 'Amazon Excursions' },
      { href: '/en/resort', label: 'Ceremonial Center' },
      { href: '/en/about', label: 'Our Story' },
      { href: '/en/testimonials', label: 'Testimonials' },
      { href: '/en/blog', label: 'Blog' }
    ],
    helpLinks: [
      { href: '/en/booking', label: 'Book Now' },
      { href: '/en/pricing', label: 'Pricing' },
      { href: '/en/calendar', label: 'Calendar' },
      { href: '/en/contact', label: 'Contact Us' },
      { href: '/en/faqs', label: 'FAQ' },
      { href: '/en/diet', label: 'Diet' },
      { href: '/en/safety', label: 'Safety' },
      { href: '/en/cancellation', label: 'Cancellation' },
      { href: '/en/how-to-prepare-for-ayahuasca-ceremony-complete-guide', label: 'Preparation Guide' }
    ],
    businessHours: {
      weekdays: "Monday–Friday:",
      weekend: "Saturday–Sunday:"
    },
    newsletterForm: {
      firstName: "First Name",
      lastName: "Last Name",
      email: "Email Address",
      consent: "I agree to receive marketing emails and accept the",
      terms: "Terms",
      privacy: "Privacy Policy",
      subscribe: "Subscribe"
    },
    copyright: "© 2025 Casa del Jaguar. All rights reserved.",
    legal: {
      terms: "Terms of Service",
      privacy: "Privacy Policy"
    }
  }
};

const content = footerContent[lang] || footerContent.es;
---

<footer class={`bg-brand-dark text-brand-light ${className} scroll-animate`}>
  <div class="w-full max-w-[1500px] mx-auto py-12 px-6 lg:px-8">
    <div class="max-w-[1500px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
        
        <div class="footer-column" data-accordion="main-menu">
          <h3 class="footer-title font-georgia text-lg font-semibold mb-6 text-[#F2CF8D] lg:cursor-default cursor-pointer flex items-center justify-between">
            {content.mainMenu}
            <span class="lg:hidden accordion-icon transition-transform duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </h3>
          <div class="footer-content max-h-0 lg:max-h-none overflow-hidden lg:overflow-visible transition-all duration-300">
            <ul class="space-y-3">
              {content.mainMenuLinks.map(link => (
                <li><a href={link.href} class="footer-link">{link.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-column" data-accordion="help">
          <h3 class="footer-title font-georgia text-lg font-semibold mb-6 text-[#F2CF8D] lg:cursor-default cursor-pointer flex items-center justify-between">
            {content.help}
            <span class="lg:hidden accordion-icon transition-transform duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </h3>
          <div class="footer-content max-h-0 lg:max-h-none overflow-hidden lg:overflow-visible transition-all duration-300">
            <ul class="space-y-3">
              {content.helpLinks.map(link => (
                <li><a href={link.href} class="footer-link">{link.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-column" data-accordion="contact">
          <h3 class="footer-title font-georgia text-lg font-semibold mb-6 text-[#F2CF8D] lg:cursor-default cursor-pointer flex items-center justify-between">
            {content.callToday}
            <span class="lg:hidden accordion-icon transition-transform duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </h3>
          <div class="footer-content max-h-0 lg:max-h-none overflow-hidden lg:overflow-visible transition-all duration-300">
            <div class="space-y-4">
              <div>
                <a href="tel:+51917811803" class="text-[#F2CF8D] hover:text-[#F2E8D5] transition-colors text-2xl font-semibold font-gotham">
                  +51 917 811 803
                </a>
              </div>
              <div class="text-sm font-gotham text-[#F2E8D5] space-y-2">
                <p><strong>{content.businessHours.weekdays}</strong><br>6 am–8 pm PT / 9 am–11 pm ET</p>
                <p><strong>{content.businessHours.weekend}</strong><br>6 am–5 pm PT / 9 am–8 pm ET</p>
              </div>
              <div class="pt-2">
                <a href="mailto:info@casadeljaguariquitos.com" class="footer-link text-sm">
                  info@casadeljaguariquitos.com
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="footer-column scroll-animate" data-accordion="newsletter">
          <h3 class="footer-title font-georgia text-lg font-semibold mb-6 text-[#F2CF8D] lg:cursor-default cursor-pointer flex items-center justify-between">
            {content.newsletter}
            <span class="lg:hidden accordion-icon transition-transform duration-300">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </h3>
          <div class="footer-content max-h-0 lg:max-h-none overflow-hidden lg:overflow-visible transition-all duration-300">
            <form class="newsletter-form space-y-4">
              <!-- Honeypot field: must remain empty -->
              <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;height:0;overflow:hidden;" aria-hidden="true">
                <input type="text" name="honeypot" id="hp-newsletter" tabindex="-1" autocomplete="off" />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-3">
                <div>
                  <label for="newsletter-first-name" class="block text-sm font-gotham text-[#F2E8D5] mb-1">{content.newsletterForm.firstName}</label>
                  <input 
                    type="text" 
                    id="newsletter-first-name" 
                    name="firstName" 
                    required
                    class="w-full px-3 py-2 text-sm bg-brand-light text-brand-dark rounded border border-transparent focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-brand-primary transition-colors"
                    placeholder={content.newsletterForm.firstName}
                  >
                </div>
                <div>
                  <label for="newsletter-last-name" class="block text-sm font-gotham text-[#F2E8D5] mb-1">{content.newsletterForm.lastName}</label>
                  <input 
                    type="text" 
                    id="newsletter-last-name" 
                    name="lastName" 
                    required
                    class="w-full px-3 py-2 text-sm bg-brand-light text-brand-dark rounded border border-transparent focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-brand-primary transition-colors"
                    placeholder={content.newsletterForm.lastName}
                  >
                </div>
              </div>
              <div>
                <label for="newsletter-email" class="block text-sm font-gotham text-[#F2E8D5] mb-1">{content.newsletterForm.email}</label>
                <input 
                  type="email" 
                  id="newsletter-email" 
                  name="email" 
                  required
                  class="w-full px-3 py-2 text-sm bg-[#F2CF8D] text-brand-dark rounded border border-transparent focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-brand-primary transition-colors"
                  placeholder="your@email.com"
                >
              </div>
              <div class="flex items-start space-x-2">
                <input 
                  type="checkbox" 
                  id="newsletter-consent" 
                  name="consent" 
                  required
                  class="mt-1 w-4 h-4 text-brand-primary bg-[#F2CF8D] border-gray-300 rounded focus:ring-[#402A1E] focus:ring-2"
                >
                <label for="newsletter-consent" class="text-xs font-gotham text-[#F2CF8D] opacity-90 leading-relaxed">
                  {content.newsletterForm.consent} 
                  <a href={lang === 'en' ? '/en/terms' : '/terms'} class="text-brand-primary hover:text-[#F2CF8D] underline">{content.newsletterForm.terms}</a> & 
                  <a href={lang === 'en' ? '/en/privacy' : '/privacy'} class="text-brand-primary hover:text-[#F2CF8D] underline">{content.newsletterForm.privacy}</a>
                </label>
              </div>
              <button 
                type="submit" 
                class="w-full bg-[#F2E8D5] text-brand-dark px-4 py-2 rounded font-semibold font-gotham text-sm hover:bg-brand-light transition-colors focus:outline-none focus:ring-2 focus:ring-brand-light focus:ring-offset-2 focus:ring-offset-brand-dark"
              >
                {content.newsletterForm.subscribe}
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-[1500px] mx-auto mt-12 mb-8">
      <div class="h-px bg-brand-light opacity-20"></div>
    </div>

    <div class="max-w-[1500px] mx-auto">
      <div class="flex flex-col lg:flex-row items-center justify-between space-y-6 lg:space-y-0">
        
        <div class="flex space-x-6 order-1 lg:order-1">
          <a href="https://www.facebook.com/ayahuascamadreiquitos" target="_blank" rel="noopener noreferrer" 
             class="social-icon" 
             aria-label="Facebook">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="https://x.com/ayaiquitos" target="_blank" rel="noopener noreferrer" 
             class="social-icon" 
             aria-label="X (formerly Twitter)">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
        </div>

        <div class="text-sm font-gotham text-brand-cream opacity-90 text-center order-3 lg:order-2">
          {content.copyright}
        </div>

        <div class="flex space-x-6 text-sm font-gotham order-2 lg:order-3">
          <a href={lang === 'en' ? '/en/terms' : '/terms'} class="footer-link">{content.legal.terms}</a>
          <a href={lang === 'en' ? '/en/privacy' : '/privacy'} class="footer-link">{content.legal.privacy}</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: #F2E8D5;
    font-family: 'Gotham', sans-serif;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  
  .footer-link:hover {
    color: #F2AB27;
  }
  
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #F2E8D5;
    background-color: transparent;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }
  
  .social-icon:hover {
    background-color: rgba(242, 171, 39, 0.2);
    color: #F2AB27;
    border-color: #F2AB27;
  }

  @media (max-width: 1023px) {
    .footer-column[data-expanded="true"] .footer-content {
      max-height: 384px;
      padding-bottom: 16px;
    }
    
    .footer-column[data-expanded="true"] .accordion-icon {
      transform: rotate(180deg);
    }
  }

  @media (min-width: 1024px) {
    .accordion-icon {
      display: none;
    }
  }
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth < 1024) {
    const columns = document.querySelectorAll('.footer-column');
    
    columns.forEach(column => {
      const title = column.querySelector('.footer-title');
      const content = column.querySelector('.footer-content');
      
      if (title && content) {
        title.addEventListener('click', () => {
          const isExpanded = column.getAttribute('data-expanded') === 'true';
          
          columns.forEach(otherColumn => {
            if (otherColumn !== column) {
              otherColumn.setAttribute('data-expanded', 'false');
            }
          });
          
          column.setAttribute('data-expanded', isExpanded ? 'false' : 'true');
        });
      }
    });
  }

  const newsletterForm = document.querySelector('.newsletter-form');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const honeypotEl = newsletterForm.querySelector('#hp-newsletter');
      const honeypot = honeypotEl ? honeypotEl.value : '';
      if (honeypot) return;
    });
  }

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      document.querySelectorAll('.footer-column').forEach(column => {
        column.removeAttribute('data-expanded');
      });
    }
  });
});
</script>
