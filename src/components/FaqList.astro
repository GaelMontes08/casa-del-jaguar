---
import { faqJsonLd, faqs, type FaqSection } from '@/data/faqs';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const sections: FaqSection[] = faqs[lang] ?? faqs.es;
const jsonLd = faqJsonLd(lang);
---

<script type="application/ld+json" set:html={jsonLd} />

{sections.map((section) => (
  <div class="mb-12">
    <h2 class="text-3xl font-bold text-gray-900 mb-8 font-georgia text-center">{section.title}</h2>
    <div class="space-y-6">
      {section.items.map((item) => (
        <details open class="faq-item bg-white border border-gray-200 rounded-lg shadow-sm">
          <summary class="cursor-pointer list-none p-6 flex justify-between items-center gap-4 hover:bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900 font-georgia">{item.question}</h3>
            <svg class="faq-chevron w-5 h-5 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-6 pb-6">
            {item.html ? (
              <p class="text-gray-600 font-gotham" set:html={item.html} />
            ) : (
              <p class="text-gray-600 font-gotham">{item.answer}</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
))}

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
