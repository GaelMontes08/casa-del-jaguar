---
/**
 * PayPal hosted-button deposit. The client id and button id are public.
 * PUBLIC_PAYPAL_CLIENT_ID and PUBLIC_PAYPAL_HOSTED_BUTTON_ID override the defaults.
 */
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const DEFAULT_CLIENT_ID =
  'BAAqnRgF_bqrcvj73lm-_-FkvTMoG8dLJCVt9vpkjrb9eA0MxMX41H3LcaPS2G3z3GzQVFgO1_pGMM-FE0';
const DEFAULT_BUTTON_ID = 'CU3UYSHYEN2KJ';
const SAFE_ID = /^[A-Za-z0-9_-]{8,180}$/;

function pick(value: unknown, fallback: string): string {
  if (typeof value !== 'string') return fallback;
  const trimmed = value.trim();
  return SAFE_ID.test(trimmed) ? trimmed : fallback;
}

const clientId = pick(import.meta.env.PUBLIC_PAYPAL_CLIENT_ID, DEFAULT_CLIENT_ID);
const buttonId = pick(import.meta.env.PUBLIC_PAYPAL_HOSTED_BUTTON_ID, DEFAULT_BUTTON_ID);
const containerId = `paypal-container-${buttonId}`;

const copy = lang === 'en'
  ? {
      title: 'Deposit, $100 USD',
      body: 'Pay the $100 USD deposit with PayPal. We refund it if we decline the application for safety. Use the same name and email in PayPal as on this application. The deposit does not confirm the retreat.',
      fallback: 'PayPal did not load. Email info@casadeljaguariquitos.com or message us on WhatsApp.',
    }
  : {
      title: 'Depósito de $100 USD',
      body: 'Paga el depósito de $100 USD con PayPal. Lo devolvemos si rechazamos la solicitud por seguridad. Usa en PayPal el mismo nombre y el mismo correo de esta solicitud. El depósito no confirma el retiro.',
      fallback: 'PayPal no cargó. Escríbenos a info@casadeljaguariquitos.com o por WhatsApp.',
    };
---

<div class="rounded-xl border border-[#d5c8b3] bg-[#fffcf6] p-4" data-paypal-deposit>
  <h3 class="font-georgia text-xl font-bold text-brand-dark">{copy.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-brand-dark/80 font-gotham">{copy.body}</p>
  <div id={containerId} class="paypal-hosted mt-4 min-h-11"></div>
  <p id={`${containerId}-fallback`} class="paypal-fallback mt-4 hidden text-sm leading-relaxed text-brand-dark font-gotham">
    {copy.fallback}
    {' '}
    <a class="underline" href="mailto:info@casadeljaguariquitos.com">info@casadeljaguariquitos.com</a>
    {' · '}
    <a class="underline" href="https://wa.me/51917811803" target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </p>
  <noscript>
    <p class="mt-4 text-sm leading-relaxed text-brand-dark font-gotham">
      {copy.fallback}
      <a class="underline" href="mailto:info@casadeljaguariquitos.com">info@casadeljaguariquitos.com</a>
    </p>
  </noscript>
</div>

<script is:inline define:vars={{ clientId, buttonId, containerId }}>
  (function () {
    var container = document.getElementById(containerId);
    var fallback = document.getElementById(containerId + '-fallback');
    var settled = false;
    function showFallback() {
      if (settled) return;
      settled = true;
      if (container) container.hidden = true;
      if (fallback) fallback.classList.remove('hidden');
    }
    if (!container) return;
    var sdk = document.createElement('script');
    sdk.src = 'https://www.paypal.com/sdk/js?client-id=' + encodeURIComponent(clientId) + '&components=hosted-buttons&disable-funding=venmo&currency=USD';
    sdk.async = true;
    var timer = setTimeout(showFallback, 15000);
    sdk.onload = function () {
      clearTimeout(timer);
      if (settled) return;
      var paypal = window.paypal;
      if (!paypal || typeof paypal.HostedButtons !== 'function') {
        showFallback();
        return;
      }
      Promise.resolve(paypal.HostedButtons({ hostedButtonId: buttonId }).render('#' + containerId))
        .then(function () { settled = true; })
        .catch(showFallback);
    };
    sdk.onerror = function () {
      clearTimeout(timer);
      showFallback();
    };
    document.head.appendChild(sdk);
  })();
</script>
