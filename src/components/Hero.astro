---
import { getLangFromUrl, translatePath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const es = lang !== 'en';
---

<section class="hero-section relative -mt-16">
  <img
    src="/img/maloca-ceremonial.webp"
    alt={es ? 'Maloca ceremonial de Casa del Jaguar en Iquitos' : 'Casa del Jaguar ceremonial maloca in Iquitos'}
    width="942"
    height="628"
    class="hero-media"
    fetchpriority="high"
    decoding="async"
  />
  <div class="photo-scrim" aria-hidden="true"></div>
  <video
    id="hero-video"
    class="hero-media hidden"
    muted
    loop
    playsinline
    preload="none"
    poster="/img/maloca-ceremonial.webp"
    aria-label={es ? 'Video de presentación de Casa del Jaguar' : 'Casa del Jaguar presentation video'}
  ></video>

  <div class="relative z-20 w-full max-w-[1500px] mx-auto px-5 sm:px-8 lg:px-12 pt-28 pb-12 md:pt-36 md:pb-20">
    <div class="max-w-3xl lg:max-w-[46rem]">
      <h1 class="text-[clamp(1.65rem,2.3vw,3rem)] leading-[1.15] font-bold font-georgia text-white">
        {es ? (
          <>
            <span class="md:whitespace-nowrap">Retiro de Ayahuasca en Iquitos:</span>
            <span class="mt-1 block text-brand-gold text-balance md:whitespace-nowrap">7 días para sanar y renacer</span>
          </>
        ) : (
          <>
            <span class="md:whitespace-nowrap">Ayahuasca Retreat in Iquitos:</span>
            <span class="mt-1 block text-brand-gold text-balance md:whitespace-nowrap">7 Days to Heal and Be Reborn</span>
          </>
        )}
      </h1>

      <p class="mt-5 text-base sm:text-lg md:text-xl font-gotham leading-relaxed text-white/95 max-w-xl">
        {es
          ? 'Un retiro de 7 días y 6 noches en la ciudad de Iquitos. Denis Montes guía el programa. Las ceremonias, en inglés, las conduce con chamanes indígenas, y él traduce.'
          : 'A 7-day, 6-night retreat in the city of Iquitos. Denis Montes guides the programme. Indigenous shamans lead the ceremonies with him, in English, and he translates.'}
      </p>

      <div class="mt-6 flex flex-col items-stretch gap-3 pr-16 sm:pr-0 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={translatePath('/booking', lang)}
          class="book-now bg-brand-gold text-brand-dark px-6 py-3.5 rounded-lg font-bold text-base sm:text-lg text-center font-gotham shadow-lg uppercase"
        >
          {es ? 'Reserva Ahora' : 'Book Now'}
        </a>
        <button
          id="watch-video-btn"
          type="button"
          class="inline-flex items-center justify-center gap-2 bg-white text-brand-dark px-6 py-3.5 rounded-lg font-semibold text-base sm:text-lg font-gotham uppercase"
          aria-label={es ? 'Reproducir video de presentación de Casa del Jaguar' : 'Play Casa del Jaguar presentation video'}
        >
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
          {es ? 'Mira el video' : 'Watch the Video'}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.getElementById('watch-video-btn');
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (!button || !video) return;

    button.addEventListener('click', function() {
      if (!video.getAttribute('src')) {
        video.src = '/hero.mp4';
      }
      video.classList.remove('hidden');
      video.play().catch(function() {
        // Playback can fail if the browser blocks it; the poster stays visible.
      });
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: calc(100svh - 3.25rem);
    display: flex;
    align-items: flex-end;
  }

  @media (min-width: 768px) {
    .hero-section {
      align-items: center;
      min-height: 42rem;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .book-now:hover {
    background-color: #F2CF8D;
  }
</style>
