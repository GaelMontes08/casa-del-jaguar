---
import type { PolicyPage } from '@/data/policies';

interface Props {
  page: PolicyPage;
}
const { page } = Astro.props;
---

<article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
  <h1 class="font-georgia text-4xl font-bold leading-tight text-brand-dark md:text-5xl">{page.title}</h1>
  <p class="mt-6 text-lg leading-relaxed text-brand-dark font-gotham">{page.lede}</p>
  {page.sections.map((section) => (
    <section class="mt-10">
      <h2 class="font-georgia text-2xl font-bold text-brand-dark">{section.heading}</h2>
      {section.paragraphs?.map((paragraph) => (
        <p class="mt-4 leading-relaxed text-brand-dark/90 font-gotham">{paragraph}</p>
      ))}
      {section.items && (
        <ul class="mt-4 list-disc space-y-2 pl-5 font-gotham leading-relaxed text-brand-dark/90">
          {section.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </section>
  ))}
</article>
