---
import { getLangFromUrl, getLocalizedPath, useTranslations, translatePath } from '@/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
---

<header id="main-header" class="bg-transparent sticky top-0 left-0 right-0 z-40 transition-all duration-300 ease-in-out">
  <div class="w-full max-w-[1920px] mx-auto">
    <nav class="w-full px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 h-16">
      <div class="flex items-center shrink-0">
        <a href={translatePath('/', lang)} class="flex items-center shrink-0">
          <img src="/cj-icon-light.webp" alt="Casa del Jaguar" width="516" height="516" class="h-10 w-auto sm:hidden" loading="eager" fetchpriority="high">
          <img src="/cj-logo.webp" alt="Casa del Jaguar Logo" width="1930" height="250" class="hidden sm:block w-[150px] xl:w-[140px] 2xl:w-[200px] h-auto max-h-10 object-contain" loading="eager" fetchpriority="high">
        </a>
      </div>
      
      <div class="hidden xl:flex justify-center min-w-0">
        <div class="flex items-center gap-1 whitespace-nowrap">
          <div class="relative group">
            <button 
              class="text-white hover:text-brand-light px-2 py-2 rounded-md text-sm font-bold font-gotham flex items-center"
              aria-label={lang === 'es' ? 'Abrir menú de experiencias' : 'Open experiences menu'}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {lang === 'es' ? 'Experiencias' : 'Experiences'}
              <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 absolute top-full left-0 mt-2 w-64 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-50">
              <div class="py-2 font-bold">
                <a href={translatePath('/casa-del-jaguar-way', lang)} class="block px-4 py-2 text-sm text-brand-dark hover:bg-brand-light font-gotham">
                  {lang === 'es' ? 'La forma de la Casa del Jaguar' : 'The Casa del Jaguar Way'}
                </a>
                <a href={translatePath('/ayahuasca-ceremonies', lang)} class="block px-4 py-2 text-sm text-brand-dark hover:bg-brand-light font-gotham">
                  {lang === 'es' ? 'Ceremonias de Ayahuasca' : 'Ayahuasca Ceremonies'}
                </a>
              </div>
            </div>
          </div>

          <a href={translatePath('/excursions', lang)} class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham">
            {lang === 'es' ? 'Excursiones' : 'Excursions'}
          </a>

          <a href={translatePath('/resort', lang)} class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham">
            {lang === 'es' ? 'Centro Ceremonial' : 'Resort'}
          </a>

          <a href={translatePath('/calendar', lang)} class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham">
            {lang === 'es' ? 'Calendario' : 'Calendar'}
          </a>
          
          <a href={translatePath('/pricing', lang)} class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham">
            {lang === 'es' ? 'Precios' : 'Pricing'}
          </a>
          
          <a href={translatePath('/testimonials', lang)} class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham">
            {lang === 'es' ? 'Testimonios' : 'Testimonials'}
          </a>

          <div class="relative group">
            <button 
              class="text-white hover:text-brand-primary px-2 py-2 rounded-md text-sm font-bold font-gotham flex items-center"
              aria-label={lang === 'es' ? 'Abrir menú de información' : 'Open learn more menu'}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {lang === 'es' ? 'Saber Más' : 'Learn More'}
              <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 absolute top-full left-0 mt-2 w-56 bg-white rounded-md shadow-lg ring-1 ring-black ring-opacity-5 z-50">
              <div class="py-2">
                <a href={translatePath('/about', lang)} class="block px-4 py-2 text-sm font-bold text-brand-dark hover:bg-brand-light font-gotham">
                  {lang === 'es' ? 'Sobre Nosotros' : 'About Us'}
                </a>
                <a href={translatePath('/faqs', lang)} class="block px-4 py-2 text-sm font-bold text-brand-dark hover:bg-brand-light font-gotham">
                  {lang === 'es' ? 'Preguntas Frecuentes' : 'FAQ'}
                </a>
                <a href={translatePath('/blog', lang)} class="block px-4 py-2 text-sm font-bold text-brand-dark hover:bg-brand-light font-gotham">
                  Blog
                </a>
                <a href={translatePath('/contact', lang)} class="block px-4 py-2 text-sm font-bold text-brand-dark hover:bg-brand-light font-gotham">
                  {lang === 'es' ? 'Contáctanos' : 'Contact Us'}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex items-center gap-1.5 shrink-0 whitespace-nowrap">
        <a href="tel:+51917811803" aria-label={lang === 'es' ? 'Llamar a Casa del Jaguar: +51 917 811 803' : 'Call Casa del Jaguar: +51 917 811 803'} class="header-tool inline-flex xl:hidden">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>
        <a href="tel:+51917811803" aria-label={lang === 'es' ? 'Llamar a Casa del Jaguar: +51 917 811 803' : 'Call Casa del Jaguar: +51 917 811 803'} class="hidden xl:inline-flex min-h-11 items-center gap-2 rounded-lg bg-white px-3 py-2 font-gotham font-bold text-brand-dark">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden 2xl:inline">+51 917 811 803</span>
        </a>

        <a href={translatePath('/booking', lang)} class="hidden sm:inline-flex xl:hidden header-tool px-2 text-[11px] font-bold tracking-wide">
          {lang === 'es' ? 'Reservar' : 'Book'}
        </a>
        <a href={translatePath('/booking', lang)} class="hidden xl:inline-flex items-center rounded-lg bg-brand-dark px-4 py-3 font-gotham font-bold text-brand-cream">
          {lang === 'es' ? 'Reserva Ahora' : 'Book Now'}
        </a>

        <div class="xl:hidden flex h-11 items-stretch overflow-hidden rounded-lg border border-white/40 text-[11px] font-bold tracking-wide" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
          <a href={getLocalizedPath(currentPath, lang, 'es')} class={`inline-flex items-center px-2 ${lang === 'es' ? 'bg-white text-brand-dark' : 'text-white'}`} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href={getLocalizedPath(currentPath, lang, 'en')} class={`inline-flex items-center px-2 ${lang === 'en' ? 'bg-white text-brand-dark' : 'text-white'}`} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <div class="hidden xl:block">
          <LanguageSwitcher />
        </div>
        
        <button 
          type="button" 
          class="header-tool inline-flex xl:hidden"
          id="mobile-menu-button"
          aria-label={lang === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div 
      class="xl:hidden hidden max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain"
      id="mobile-menu"
      role="menu"
      aria-labelledby="mobile-menu-button"
    >
      <div class="mt-2 rounded-xl bg-white py-2 shadow-lg">
        <p class="px-4 pt-2 text-xs font-bold uppercase tracking-wide text-brand-dark/60 font-gotham">{lang === 'es' ? 'Experiencias' : 'Experiences'}</p>
        <a href={translatePath('/casa-del-jaguar-way', lang)} class="mobile-link">{lang === 'es' ? 'La forma de la Casa del Jaguar' : 'The Casa del Jaguar Way'}</a>
        <a href={translatePath('/ayahuasca-ceremonies', lang)} class="mobile-link">{lang === 'es' ? 'Ceremonias de Ayahuasca' : 'Ayahuasca Ceremonies'}</a>
        <a href={translatePath('/excursions', lang)} class="mobile-link">{lang === 'es' ? 'Excursiones Amazónicas' : 'Amazon Excursions'}</a>
        <a href={translatePath('/resort', lang)} class="mobile-link">{lang === 'es' ? 'Centro Ceremonial' : 'Resort'}</a>
        <a href={translatePath('/pricing', lang)} class="mobile-link">{lang === 'es' ? 'Precios' : 'Pricing'}</a>
        <a href={translatePath('/calendar', lang)} class="mobile-link">{lang === 'es' ? 'Calendario' : 'Calendar'}</a>
        <a href={translatePath('/testimonials', lang)} class="mobile-link">{lang === 'es' ? 'Testimonios' : 'Testimonials'}</a>
        <p class="mt-2 px-4 pt-2 text-xs font-bold uppercase tracking-wide text-brand-dark/60 font-gotham">{lang === 'es' ? 'Saber más' : 'Learn more'}</p>
        <a href={translatePath('/about', lang)} class="mobile-link">{lang === 'es' ? 'Sobre nosotros' : 'About us'}</a>
        <a href={translatePath('/faqs', lang)} class="mobile-link">{lang === 'es' ? 'Preguntas frecuentes' : 'FAQ'}</a>
        <a href={translatePath('/blog', lang)} class="mobile-link">Blog</a>
        <a href={translatePath('/contact', lang)} class="mobile-link">{lang === 'es' ? 'Contáctanos' : 'Contact us'}</a>
        <div class="grid grid-cols-2 gap-2 px-3 pb-2 pt-3">
          <a href="tel:+51917811803" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-brand-dark text-sm font-bold text-brand-dark font-gotham">
            {lang === 'es' ? 'Llamar' : 'Call'}
          </a>
          <a href={translatePath('/booking', lang)} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-dark text-sm font-bold text-white font-gotham">
            {lang === 'es' ? 'Reservar' : 'Book'}
          </a>
        </div>
      </div>
    </div>
  </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.getElementById('main-header');
    
    if (mobileMenuButton && mobileMenu) {
      function closeMobileMenu() {
        mobileMenu?.classList.add('hidden');
        mobileMenuButton?.setAttribute('aria-expanded', 'false');
      }

      mobileMenuButton.addEventListener('click', function() {
        const isExpanded = mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        mobileMenuButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          closeMobileMenu();
          mobileMenuButton.focus();
        }
      });

      window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
        if (event.matches) closeMobileMenu();
      });
    }

    if (header) {
      let scrollTimeout: number | undefined;
      
      function handleScroll() {
        if (scrollTimeout) {
          clearTimeout(scrollTimeout);
        }
        
        scrollTimeout = window.setTimeout(() => {
          const scrollY = window.scrollY;
          
          if (header) {
            if (scrollY > 50) {
              header.classList.add('scrolled');
            } else {
              header.classList.remove('scrolled');
            }
          }
        }, 10);
      }
      
      window.addEventListener('scroll', handleScroll);
      
      // Initial check
      handleScroll();
    }
  });
</script>

<style>
  /* Sticky header styles */
  #main-header {
    background-color: #402A1E;
  }

  #main-header.scrolled {
    background-color: #402A1E;
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.1);
  }

  .header-tool {
    height: 2.75rem;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .mobile-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 1rem;
    font-family: gotham, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.95rem;
    color: #402A1E;
  }

  /* Dropdown hover effects */
  .group:hover .group-hover\:opacity-100 {
    opacity: 1;
  }
  .group:hover .group-hover\:visible {
    visibility: visible;
  }

  /* Ensure dropdowns appear above blur backdrop */
  .group .absolute {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
</style>
