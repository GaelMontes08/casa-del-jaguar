---
import { getLangFromUrl } from '@/i18n/utils';
import PayPalDeposit from '@/components/PayPalDeposit.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  className?: string;
  labels?: {
    firstName: string;
    lastName: string;
    email: string;
    phone: string;
    submit: string;
    privacy: string;
    firstNamePlaceholder: string;
    lastNamePlaceholder: string;
    emailPlaceholder: string;
    phonePlaceholder: string;
  };
}

const { 
  title = "Solicitud de salud",
  subtitle = "La plaza no queda reservada al enviar este formulario. La confirmamos después de leer tus respuestas.",
  buttonText = "Enviar solicitud",
  className = "",
  labels = {
    firstName: "Nombre *",
    lastName: "Apellido *", 
    email: "Correo electrónico *",
    phone: "Número de teléfono *",
    submit: "Enviar solicitud",
    privacy: "Al enviar este formulario, aceptas que nos pongamos en contacto contigo para procesar tu reserva.",
    firstNamePlaceholder: "Tu nombre",
    lastNamePlaceholder: "Tu apellido",
    emailPlaceholder: "tu@email.com",
    phonePlaceholder: "123456789"
  }
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const es = lang !== 'en';
const health = es ? {
  age: 'Edad *',
  medications: 'Medicamentos que tomas, incluidas dosis *',
  medicationsHint: 'Escribe “ninguno” si no tomas nada. Incluye antidepresivos, IMAO, ansiolíticos, hierba de San Juan, 5-HTP y tramadol.',
  antidepressants: '¿Tomas antidepresivos o IMAO ahora? *',
  pregnancy: '¿Estás embarazada o en lactancia? *',
  heart: '¿Tienes un problema cardíaco? *',
  bloodPressure: '¿Tienes la presión arterial alta? *',
  seizures: '¿Has tenido convulsiones o epilepsia? *',
  psychiatric: '¿Tienes diagnóstico de psicosis, bipolar o esquizofrenia? *',
  recentDrugs: '¿Has usado drogas en las últimas semanas? *',
  doctor: 'Nombre y contacto de tu médico *',
  yes: 'Sí',
  no: 'No',
  na: 'No aplica',
  choose: 'Elige',
  sending: 'Enviando solicitud...',
  successTitle: 'Solicitud recibida',
  successBody: 'Vamos a leerla. La plaza no está confirmada todavía. Si la ceremonia no es segura para ti, devolvemos el depósito de $100 USD.',
  errorTitle: 'No se pudo enviar',
  required: 'Este campo es requerido',
  ageError: 'Hay que tener 18 años o más',
} : {
  age: 'Age *',
  medications: 'Medicines you take, including doses *',
  medicationsHint: 'Write “none” if you take nothing. Include antidepressants, MAOIs, anxiolytics, St. John’s wort, 5-HTP, and tramadol.',
  antidepressants: 'Are you taking antidepressants or MAOIs now? *',
  pregnancy: 'Are you pregnant or breastfeeding? *',
  heart: 'Do you have a heart condition? *',
  bloodPressure: 'Do you have high blood pressure? *',
  seizures: 'Have you had seizures or epilepsy? *',
  psychiatric: 'Have you been diagnosed with psychosis, bipolar disorder, or schizophrenia? *',
  recentDrugs: 'Have you used drugs in recent weeks? *',
  doctor: 'Your doctor’s name and contact *',
  yes: 'Yes',
  no: 'No',
  na: 'Not applicable',
  choose: 'Choose',
  sending: 'Sending application...',
  successTitle: 'Application received',
  successBody: 'We will read it. The place is not confirmed yet. If the ceremony is not safe for you, we refund the $100 USD deposit.',
  errorTitle: 'Could not send',
  required: 'This field is required',
  ageError: 'You must be 18 or older',
};
const dateLabels = lang === 'en' ? {
  arrival: 'Preferred arrival date (optional)',
  hint: '7 days and 6 nights. Dates and availability are confirmed by our team before booking.',
  format: 'Month / day / year',
  departure: 'Departure',
} : {
  arrival: 'Fecha de llegada preferida (opcional)',
  hint: '7 días y 6 noches. Nuestro equipo confirma las fechas y la disponibilidad antes de reservar.',
  format: 'Día / mes / año',
  departure: 'Salida',
};
---

<div class={`booking-form-container ${className}`}>
  {title && (
    <div class="text-center mb-8">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-dark font-georgia mb-4 leading-tight">
        {title}
      </h2>
      {subtitle && (
        <p class="text-gray-600 text-lg font-gotham max-w-2xl mx-auto">
          {subtitle}
        </p>
      )}
    </div>
  )}

  <form class="booking-form max-w-2xl mx-auto bg-white rounded-2xl shadow-xl p-8 border border-gray-100 mb-8" id="bookingForm">
    <!-- Honeypot field: must remain empty -->
    <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;height:0;overflow:hidden;" aria-hidden="true">
      <input type="text" name="honeypot" id="hp-booking" tabindex="-1" autocomplete="off" />
    </div>
    <div class="form-group mb-6 rounded-xl border border-[#d5c8b3] bg-[#fffcf6] p-4">
      <label for="arrivalDate" class="block text-sm font-semibold text-brand-dark mb-2 font-gotham">{dateLabels.arrival}</label>
      <input type="date" id="arrivalDate" name="arrivalDate" lang={lang} max="9999-12-25" aria-describedby="arrivalFormat arrivalHint arrivalDeparture arrivalError"
        class="w-full min-w-0 px-4 py-3 border border-gray-300 rounded-lg font-gotham text-gray-700 bg-white" />
      <p id="arrivalFormat" class="mt-2 text-sm font-semibold text-brand-dark">{dateLabels.format}</p>
      <p id="arrivalHint" class="mt-2 text-sm text-gray-600">{dateLabels.hint}</p>
      <p id="arrivalDeparture" class="mt-2 text-sm font-bold text-brand-dark" data-departure-label={dateLabels.departure} aria-live="polite"></p>
      <span id="arrivalError" class="error-message text-red-500 text-sm hidden" aria-live="polite"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div class="form-group">
        <label for="firstName" class="block text-sm font-semibold text-brand-dark mb-2 font-gotham">
          {labels.firstName}
        </label>
        <input
          type="text"
          id="firstName"
          name="firstName"
          required
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F2AB27] focus:border-transparent transition-all duration-200 font-gotham text-gray-700 bg-gray-50 focus:bg-white"
          placeholder={labels.firstNamePlaceholder}
        />
        <span class="error-message text-red-500 text-sm hidden"></span>
      </div>

      <div class="form-group">
        <label for="lastName" class="block text-sm font-semibold text-brand-dark mb-2 font-gotham">
          {labels.lastName}
        </label>
        <input
          type="text"
          id="lastName"
          name="lastName"
          required
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F2AB27] focus:border-transparent transition-all duration-200 font-gotham text-gray-700 bg-gray-50 focus:bg-white"
          placeholder={labels.lastNamePlaceholder}
        />
        <span class="error-message text-red-500 text-sm hidden"></span>
      </div>
    </div>

    <div class="form-group mb-6">
      <label for="email" class="block text-sm font-semibold text-brand-dark mb-2 font-gotham">
        {labels.email}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F2AB27] focus:border-transparent transition-all duration-200 font-gotham text-gray-700 bg-gray-50 focus:bg-white"
        placeholder={labels.emailPlaceholder}
      />
      <span class="error-message text-red-500 text-sm hidden"></span>
    </div>

    <div class="form-group mb-8">
      <label for="phone" class="block text-sm font-semibold text-brand-dark mb-2 font-gotham">
        {labels.phone}
      </label>
      <div class="flex gap-3">
        <div class="relative">
          <label for="countryCode" class="sr-only">
            {labels.phone.includes('*') ? 'Código de país *' : 'Código de país'}
          </label>
          <select
            id="countryCode"
            name="countryCode"
            required
            class="px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F2AB27] focus:border-transparent transition-all duration-200 font-gotham text-gray-700 bg-gray-50 focus:bg-white min-w-[120px]"
            aria-label={labels.phone.includes('*') ? 'Código de país requerido' : 'Código de país'}
          >
          <option value="+51">🇵🇪 +51</option>
          <option value="+1">🇺🇸 +1</option>
          <option value="+44">🇬🇧 +44</option>
          <option value="+34">🇪🇸 +34</option>
          <option value="+33">🇫🇷 +33</option>
          <option value="+49">🇩🇪 +49</option>
          <option value="+39">🇮🇹 +39</option>
          <option value="+55">🇧🇷 +55</option>
          <option value="+52">🇲🇽 +52</option>
          <option value="+54">🇦🇷 +54</option>
          <option value="+56">🇨🇱 +56</option>
          <option value="+57">🇨🇴 +57</option>
          <option value="+593">🇪🇨 +593</option>
          <option value="+58">🇻🇪 +58</option>
          <option value="+506">🇨🇷 +506</option>
          <option value="+507">🇵🇦 +507</option>
        </select>
        </div>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          class="flex-1 w-10 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#F2AB27] focus:border-transparent transition-all duration-200 font-gotham text-gray-700 bg-gray-50 focus:bg-white"
          placeholder={labels.phonePlaceholder}
        />
      </div>
      <span class="error-message text-red-500 text-sm hidden"></span>
    </div>

    <fieldset class="mb-6 space-y-4 rounded-xl border border-[#d5c8b3] p-4">
      <legend class="px-1 font-georgia text-xl font-bold text-brand-dark">{es ? 'Salud' : 'Health'}</legend>
      <div class="form-group">
        <label for="age" class="mb-2 block text-sm font-semibold text-brand-dark font-gotham">{health.age}</label>
        <input type="number" id="age" name="age" required min="18" max="120" inputmode="numeric" class="w-full rounded-lg border border-gray-300 px-4 py-3 font-gotham" />
        <span class="error-message hidden text-sm text-red-500"></span>
      </div>
      <div class="form-group">
        <label for="medications" class="mb-2 block text-sm font-semibold text-brand-dark font-gotham">{health.medications}</label>
        <textarea id="medications" name="medications" required rows="4" class="w-full rounded-lg border border-gray-300 px-4 py-3 font-gotham"></textarea>
        <p class="mt-2 text-sm text-gray-600 font-gotham">{health.medicationsHint}</p>
        <span class="error-message hidden text-sm text-red-500"></span>
      </div>
      {[
        ['antidepressants', health.antidepressants, false],
        ['pregnancy', health.pregnancy, true],
        ['heart', health.heart, false],
        ['bloodPressure', health.bloodPressure, false],
        ['seizures', health.seizures, false],
        ['psychiatric', health.psychiatric, false],
        ['recentDrugs', health.recentDrugs, false],
      ].map(([name, label, allowNa]) => (
        <div class="form-group">
          <label for={name} class="mb-2 block text-sm font-semibold text-brand-dark font-gotham">{label}</label>
          <select id={name} name={name} required class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 font-gotham">
            <option value="">{health.choose}</option>
            <option value="yes">{health.yes}</option>
            <option value="no">{health.no}</option>
            {allowNa && <option value="na">{health.na}</option>}
          </select>
          <span class="error-message hidden text-sm text-red-500"></span>
        </div>
      ))}
      <div class="form-group">
        <label for="doctor" class="mb-2 block text-sm font-semibold text-brand-dark font-gotham">{health.doctor}</label>
        <input type="text" id="doctor" name="doctor" required class="w-full rounded-lg border border-gray-300 px-4 py-3 font-gotham" />
        <span class="error-message hidden text-sm text-red-500"></span>
      </div>
    </fieldset>

    <div class="mb-6">
      <PayPalDeposit lang={lang === 'en' ? 'en' : 'es'} />
    </div>

    <!-- Loading and Success States -->
    <div id="loadingState" class="text-center hidden mb-6">
      <div class="inline-flex items-center px-4 py-2 font-semibold leading-6 text-sm shadow rounded-md text-white bg-[#D99D55] transition ease-in-out duration-150">
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        {health.sending}
      </div>
    </div>

    <div id="successState" class="text-center hidden mb-6">
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg">
        <div class="flex items-center justify-center mb-2">
          <svg class="w-6 h-6 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <strong>{health.successTitle}</strong>
        </div>
        <p class="text-sm">{health.successBody}</p>
      </div>
    </div>

    <div id="errorState" class="text-center hidden mb-6">
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">
        <div class="flex items-center justify-center mb-2">
          <svg class="w-6 h-6 text-red-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <strong>{health.errorTitle}</strong>
        </div>
        <p class="text-sm" id="errorMessage">Ha ocurrido un error. Por favor, inténtalo de nuevo.</p>
      </div>
    </div>

    <button
      type="submit"
      id="submitButton"
      class="w-full bg-brand-dark hover:bg-opacity-90 text-white font-semibold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-[1.02] focus:ring-4 focus:ring-[#F2AB27] focus:ring-opacity-50 font-gotham text-lg shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
      aria-label={`${labels.submit} - ${labels.privacy}`}
    >
      {labels.submit}
    </button>

    <p class="text-xs text-gray-500 text-center mt-4 font-gotham">
      {labels.privacy}
    </p>
  </form>
</div>

<script>
import { getIquitosToday, getDepartureDate, formatRetreatDate, isValidArrival } from '@/utils/retreat-dates';
import { getLangFromUrl } from '@/i18n/utils';

document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('bookingForm') as HTMLFormElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  const loadingState = document.getElementById('loadingState');
  const successState = document.getElementById('successState');
  const errorState = document.getElementById('errorState');
  const errorMessage = document.getElementById('errorMessage');

  if (!form || !submitButton || !loadingState || !successState || !errorState || !errorMessage) {
    console.error('Required form elements not found');
    return;
  }

  const lang = getLangFromUrl(new URL(window.location.href));
  const arrival = form.querySelector<HTMLInputElement>('#arrivalDate')!;
  const departure = form.querySelector<HTMLElement>('#arrivalDeparture')!;
  const dateError = lang === 'en'
    ? 'Choose a valid arrival date, today or later (Iquitos time).'
    : 'Elige una fecha de llegada válida, a partir de hoy (hora de Iquitos).';
  arrival.min = getIquitosToday();

  function updateDeparture() {
    arrival.setCustomValidity('');
    departure.textContent = '';
    if (arrival.value && !isValidArrival(arrival.value)) {
      arrival.setCustomValidity(dateError);
      showFieldError(arrival, dateError);
    } else {
      validateField(arrival);
      if (arrival.value) {
        departure.textContent = `${departure.dataset.departureLabel}: ${formatRetreatDate(getDepartureDate(arrival.value), lang)}`;
      }
    }
  }
  const requestedArrival = new URLSearchParams(window.location.search).get('arrival');
  if (requestedArrival !== null) {
    if (isValidArrival(requestedArrival)) {
      arrival.value = requestedArrival;
      updateDeparture();
    } else {
      arrival.setCustomValidity(dateError);
      showFieldError(arrival, dateError);
    }
  }
  arrival.addEventListener('input', updateDeparture);

  // Form validation
  function validateField(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): boolean {
    const value = field.value.trim();
    const errorElement = field.parentElement?.querySelector('.error-message') as HTMLElement;
    
    // Clear previous errors
    field.classList.remove('border-red-500');
    if (errorElement) {
      errorElement.classList.add('hidden');
      errorElement.textContent = '';
    }

    if (!value && field.hasAttribute('required')) {
      showFieldError(field, lang === 'en' ? 'This field is required' : 'Este campo es requerido');
      return false;
    }

    if (field.name === 'age') {
      const age = Number(value);
      if (!Number.isInteger(age) || age < 18 || age > 120) {
        showFieldError(field, lang === 'en' ? 'You must be 18 or older' : 'Hay que tener 18 años o más');
        return false;
      }
    }

    if (field.name === 'arrivalDate' && (field.validationMessage || (value && !isValidArrival(value)))) {
      showFieldError(field, dateError);
      return false;
    }

    if ((field.name === 'firstName' || field.name === 'lastName') && value.length < 2) {
      showFieldError(field, 'Por favor escribe al menos 2 caracteres');
      return false;
    }

    if (field.type === 'email' && value) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(value)) {
        showFieldError(field, 'Por favor, ingresa un email válido');
        return false;
      }
    }

    if (field.name === 'phone' && value) {
      const phoneRegex = /^[0-9]{6,15}$/;
      if (!phoneRegex.test(value.replace(/\s/g, ''))) {
        showFieldError(field, 'Por favor, ingresa un número de teléfono válido');
        return false;
      }
    }

    return true;
  }

  function showFieldError(field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, message: string): void {
    const errorElement = field.parentElement?.querySelector('.error-message') as HTMLElement;
    field.classList.add('border-red-500');
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }

  function hideAllStates(): void {
    if (loadingState) loadingState.classList.add('hidden');
    if (successState) successState.classList.add('hidden');
    if (errorState) errorState.classList.add('hidden');
  }

  function showLoadingState(): void {
    hideAllStates();
    if (loadingState) loadingState.classList.remove('hidden');
    submitButton.disabled = true;
  }

  function showSuccessState(): void {
    hideAllStates();
    if (successState) successState.classList.remove('hidden');
    submitButton.disabled = false;
    form.reset(); // Clear the form
    updateDeparture();
  }

  function showErrorState(message: string = 'Ha ocurrido un error. Por favor, inténtalo de nuevo.'): void {
    hideAllStates();
    if (errorMessage) errorMessage.textContent = message;
    if (errorState) errorState.classList.remove('hidden');
    submitButton.disabled = false;
  }

  // Real-time validation
  const inputs = form.querySelectorAll('input, select, textarea') as NodeListOf<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>;
  inputs.forEach(input => {
    input.addEventListener('blur', () => validateField(input));
    input.addEventListener('input', () => {
      if (input.classList.contains('border-red-500')) {
        validateField(input);
      }
    });
  });

  // Form submission
  form.addEventListener('submit', async function(e: Event) {
    e.preventDefault();

    // Honeypot check
    const honeypot = (form.querySelector('#hp-booking') as HTMLInputElement)?.value;
    if (honeypot) return;

    // Client-side rate limiting (3 per 24h)
    const RL_KEY = 'booking_rl';
    const RL_WINDOW = 24 * 60 * 60 * 1000;
    const RL_MAX = 3;
    const raw = localStorage.getItem(RL_KEY);
    if (raw) {
      const { count, windowStart } = JSON.parse(raw) as { count: number; windowStart: number };
      if (Date.now() - windowStart < RL_WINDOW && count >= RL_MAX) {
        showErrorState('Has alcanzado el límite de envíos por hoy. Inténtalo de nuevo mañana.');
        return;
      }
    }

    // Validate all fields
    let isValid = true;
    inputs.forEach(input => {
      if (!validateField(input)) {
        isValid = false;
      }
    });

    if (!isValid) {
      return;
    }

    showLoadingState();

    try {
      const formData = new FormData(form);
      
      const response = await fetch('/api/booking', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        // Record rate limit entry
        const RL_KEY = 'booking_rl';
        const RL_WINDOW = 24 * 60 * 60 * 1000;
        const now = Date.now();
        const rawRl = localStorage.getItem(RL_KEY);
        if (!rawRl) {
          localStorage.setItem(RL_KEY, JSON.stringify({ count: 1, windowStart: now }));
        } else {
          const { count, windowStart } = JSON.parse(rawRl) as { count: number; windowStart: number };
          if (now - windowStart > RL_WINDOW) {
            localStorage.setItem(RL_KEY, JSON.stringify({ count: 1, windowStart: now }));
          } else {
            localStorage.setItem(RL_KEY, JSON.stringify({ count: count + 1, windowStart }));
          }
        }
        showSuccessState();
        
        // Optional: Track the conversion with analytics
        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'booking_submitted', {
            event_category: 'engagement',
            event_label: 'booking_form',
          });
        }
      } else {
        // Check if it's a rate limit error
        if (result.rateLimitExceeded) {
          showErrorState(`🚫 ${result.error}\n\n⏰ ${result.message}\n\n💡 Si necesitas hacer una reserva urgente, puedes contactarnos directamente al teléfono.`);
        } else {
          showErrorState(result.error || 'Error al enviar la solicitud');
        }
      }
    } catch (error) {
      console.error('Form submission error:', error);
      showErrorState('Error de conexión. Por favor, verifica tu conexión a internet e inténtalo de nuevo.');
    }
  });
});
</script>

<style>
  .booking-form-container {
    @apply relative;
  }

  .form-group input:focus,
  .form-group select:focus {
  }

  .form-group input::placeholder {
  }

  /* Custom styles for better mobile experience */
  @media (max-width: 768px) {
    .booking-form {
    }
  }
</style>
