---
import Layout from '@/layouts/Layout.astro';
import { useTranslations } from '@/i18n/utils';
import GoogleReviews from '@/components/GoogleReviews.astro';
import { reviewsFor } from '@/data/reviews';

const t = useTranslations('es');
export const prerender = true;
---

<Layout
  title={t('testimonials.title')}
  description={t('testimonials.subtitle')}
  keywords={t('testimonials.keywords')}
>
  <section class="hero relative min-h-[28rem] -mt-16 pt-24 pb-12 flex items-center justify-center">
    <div class="absolute inset-0 z-0">
      <img
        src="/img/centro-pasadiso.webp" width="1448" height="1086"
        alt="Casa del Jaguar en Iquitos"
        class="w-full h-full object-cover"
      />
      <div class="photo-scrim" aria-hidden="true"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-white font-georgia mb-6">Reseñas de Google</h1>
      <p class="text-xl text-white font-gotham max-w-3xl mx-auto">
        Estas reseñas se copiaron a mano desde Google. El texto original se deja como lo escribió la persona. Si no está en español, va la traducción debajo.
      </p>
    </div>
  </section>
  <section class="py-20 bg-white">
    <div class="max-w-[1500px] mx-auto px-4 md:px-8">
      <GoogleReviews
        title="Lo que escribieron"
        note="No es un widget de Google. Es una copia de reseñas que el centro guardó."
        reviews={reviewsFor('es')}
      />
    </div>
  </section>
</Layout>
