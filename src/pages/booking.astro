---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout 
  title="Reservar - Casa del Jaguar"
  description="Solicitud de salud para el retiro de 7 días y 6 noches en Casa del Jaguar, Iquitos. $2,800 USD."
  keywords="reservar retiro ayahuasca, booking Casa del Jaguar, medicina ancestral Peru"
>
  <main class="min-h-screen bg-[#fffcf6] py-20 scroll-animate">
    <div class="max-w-4xl mx-auto px-4">
      <BookingForm 
        title="Solicitud de salud"
        subtitle="7 días y 6 noches, $2,800 USD. La plaza se confirma después de leer esta solicitud. El depósito es de $100 USD y se devuelve si la ceremonia no es segura para ti."
        buttonText="Enviar solicitud"
        showPayPal={true}
      />
    </div>
  </main>
</Layout>
