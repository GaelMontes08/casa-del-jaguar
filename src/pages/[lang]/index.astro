---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import { useTranslations, getStaticPaths, translatePath } from '@/i18n/utils';
import ImageSlider from '@/components/ImageSlider.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import { reviewsFor } from '@/data/reviews';
import BookingForm from '@/components/BookingForm.astro';
import Services from '@/components/Services.astro';
import LocationClarity from '@/components/LocationClarity.astro';
import ValueOffer from '@/components/ValueOffer.astro';

export { getStaticPaths };
export const prerender = true;

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');
---

<Layout title={t('home.title')} description={t('home.subtitle')} keywords={"ayahuasca, retreat, casa del jaguar, iquitos, amazon, plant medicine, healing, transformation, ayahuasca ceremony iquitos"}>
  <Hero />
  <main>
    <section class="py-20 bg-gradient-to-b from-brand-cream to-white">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl lg:max-w-5xl mb-16 text-center lg:text-left">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark mb-8 font-georgia leading-tight">
            A 7-day retreat in <span class="text-brand-gold">Iquitos</span>
          </h2>
          <p class="text-[19px] md:text-md text-brand-dark mb-4 font-gotham leading-relaxed">
            Casa del Jaguar is a 7-day, 6-night ayahuasca retreat in the city of Iquitos. It has worked here since 2008. The price is $2,800 USD, and the group is 8 people at most.
          </p>
          <p class="text-[19px] md:text-md text-brand-dark font-gotham leading-relaxed mb-12">
            Ceremonies are in the maloca, in the city, minutes from the airport. Indigenous shamans lead them together with Maestro Denis Montes. Denis guides the programme. Ceremonies are in English, and Denis translates. Two Amazon outings happen on integration days.
          </p>
        </div>
        <p class="font-gotham text-brand-dark">Dan Reynolds founded Casa del Jaguar in 2008 and led the ceremonies until 2014. Denis Montes has led them since 2014. The retreat costs $2,800 USD, the same price for every room.</p>
      </div>
    </section>

    <section class="pt-15 md:py-15 bg-gradient-to-r from-[#fdf6e7] to-[#fdf9f1] relative overflow-hidden scroll-animate">
      <div class="absolute top-1/2 left-0 w-[600px] h-[600px] bg-gradient-to-br from-[#F2CF8D] to-[#ffefbb] rounded-full transform -translate-x-[20px] -translate-y-[800px] md:translate-x-[610px] md:-translate-y-[500px]"></div>
      
      <div class="max-w-[1500px] mx-auto flex flex-col md:flex-row items-end gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 flex justify-end items-end order-2 md:order-1">
          <img src="/img/maestro-chaman-denis-montes.webp" width="800" height="618" alt="Maestro Chaman Denis Montes" class="w-full h-[500px] object-cover transform md:translate-y-[60px]" loading="lazy" />
        </div>
        <div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left order-1 md:order-2">
          <blockquote class="text-2xl md:text-3xl font-georgia text-brand-dark mb-6 font-semibold leading-snug">
            “I came to this medicine looking for relief. Today I sit with other people with the same care I was given.”
          </blockquote>
          <div class="text-brand-dark text-base md:text-lg font-gotham mb-8 opacity-70">
            Denis Montes was born in Iquitos in 1983. He is a chemical engineer. He has led the ceremonies since 2014, together with indigenous shamans.
          </div>
          <div class="text-sm text-brand-dark opacity-60 mb-8 font-gotham">
            — Denis Montes. He has led the ceremonies since 2014.
          </div>
          <a href={translatePath('/about', lang as string)} class="button-story transition-all inline-block bg-brand-gold text-brand-dark px-8 py-3 rounded-full font-bold text-lg shadow-lg font-gotham uppercase tracking-wide hover:scale-110">
            our story
          </a>
        </div>
      </div>
    </section>
    
    <section class="py-20 bg-gradient-to-l from-[#fdf6e7] to-[#fdf9f1] relative overflow-hidden">

      <div class="absolute top-1/2 right-0 w-[600px] h-[600px] bg-gradient-to-br from-[#F2CF8D] to-[#ffefbb] rounded-full transform -translate-x-[20px] -translate-y-[800px] md:-translate-x-[150px] md:-translate-y-[220px]"></div>

      <div class="scroll-animate max-w-[1500px] mx-auto flex flex-col md:flex-row items-center gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 space-y-8">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark font-georgia leading-tight">
            Heal your <span class="text-brand-gold">mind</span>, <span class="text-brand-gold">body</span>, and <span class="text-brand-gold">soul</span>
          </h2>
          
          <div class="text-lg md:text-xl text-brand-dark font-gotham leading-relaxed space-y-4">
            <p>
              Our program is designed to <strong>accelerate self-discovery</strong> and provide guests with the tools needed to understand and integrate their transformative experiences.
            </p>
            
            <p>
              Between ceremonies there is <strong>yoga, breathing, meditation, and Hemi-Sync</strong>, a recorded sound for quiet concentration, plus integration workshops.
            </p>
            
            <p class="text-base opacity-70">
              Our retreats are held regularly, offering flexibility so you can join when it best fits your schedule.
            </p>
          </div>
          
          <div class="pt-4">
            <a href={translatePath('/casa-del-jaguar-way', lang as string)} class="inline-block bg-brand-dark text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl font-gotham uppercase tracking-wide hover:bg-brand-gold hover:text-brand-dark transition-all duration-300 transform hover:scale-105">
              Discover the Journey
            </a>
          </div>
        </div>
        
        <div class="w-full md:w-1/2 flex justify-center">
          <img src="/img/ayahuasca-cabeza-clava.webp" width="960" height="640" alt="Ancestral Medicine - Cabeza Clava" class="w-full max-w-lg md:h-[600px] object-cover rounded-md shadow-black shadow-lg" loading="lazy" />
        </div>
      </div>
    </section>
    
    <section class="py-20 bg-gradient-to-r from-[#fdf6e7] to-[#fdf9f1] scroll-animate relative overflow-hidden">
      
      <div class="absolute top-1/2 left-0 w-[600px] h-[600px] bg-gradient-to-bl from-[#F2CF8D] to-[#ffefbb] rounded-full transform translate-x-[20px] -translate-y-[800px] md:translate-x-[150px] md:-translate-y-[250px]"></div>

      <div class="max-w-[1500px] mx-auto flex flex-col md:flex-row items-center gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 flex justify-center order-2 md:order-1">
          <img src="/img/maloca-ceremonial.webp" width="942" height="628" alt="Ceremonial Maloca - Casa del Jaguar" class="w-full max-w-lg md:h-[600px] object-cover rounded-md shadow-black shadow-lg" loading="lazy" />
        </div>
        
        <div class="w-full md:w-1/2 space-y-8 order-1 md:order-2">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark font-georgia leading-tight">
            An urban <span class="text-brand-gold">sanctuary</span> in <span class="text-brand-gold">Iquitos</span>
          </h2>
          
          <div class="text-lg md:text-xl text-brand-dark font-gotham leading-relaxed space-y-4">
            <p>
              Our center is designed as a <strong>sacred sanctuary</strong> within the city of Iquitos, where comfort, safety and tradition meet to create the ideal environment for your personal transformation.
            </p>
            
            <p>
              The <strong>ceremonial Maloca</strong> is the spiritual heart of Casa del Jaguar, a sacred space built with natural materials where ancestral plant medicine ceremonies are held under the guidance of our experienced masters.
            </p>
            
            <p>
              Ceremonies happen in the city, with medical care minutes away. The Amazon itself is one step away: our <strong>guided excursions</strong> on integration days let you experience the river, the communities and the medicinal plants on your own terms.
            </p>
            
            <p class="text-base opacity-70">
              Exclusive accommodation, conscious gastronomy, and spaces designed for contemplation and personal growth.
            </p>
          </div>
          
          <div class="pt-4">
            <a href={translatePath('/resort', lang as string)} class="inline-block bg-brand-dark text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl font-gotham uppercase tracking-wide hover:bg-brand-gold hover:text-brand-dark transition-all duration-300 transform hover:scale-105">
              Explore the Resort
            </a>
          </div>
        </div>
      </div>
    </section>
    
    <Services showCta={true}/>
    
    <LocationClarity />

    <ValueOffer />

    <section class="scroll-animate">
        <ImageSlider 
          images={[
            { src: '/img/centro-maloca.webp', alt: 'Centro Maloca - Casa del Jaguar' },
            { src: '/img/centro-pasadiso.webp', alt: 'Centro Paraíso - Casa del Jaguar' },
            { src: '/img/centro-pileta.webp', alt: 'Centro Pileta - Casa del Jaguar' },
            { src: '/img/centro-sala.webp', alt: 'Centro Sala - Casa del Jaguar' },
            { src: '/img/maloca-ceremonial.webp', alt: 'Maloca Ceremonial - Casa del Jaguar' }
          ]}
          autoplay={true}
          autoplayDelay={5000}
        />
    </section>

    <section class="py-20 bg-white scroll-animate">
      <div class="max-w-7xl mx-auto px-4 md:px-8">
        <GoogleReviews
          title="Google reviews"
          note="Copied by hand from Google reviews. The original language is shown, with a translation when the page language is different."
          reviews={reviewsFor('en')}
          autoplay={true}
          autoplayDelay={7000}
        />
      </div>
    </section>

    <section class="py-20 bg-gray-50 scroll-animate">
      <div class="max-w-[1500px] mx-auto px-4 md:px-8">
        <BookingForm 
          title="Health application"
          subtitle="The place is confirmed after we read your answers. The $100 USD deposit is refunded if the ceremony is not safe for you."
          labels={{
            firstName: "First Name *",
            lastName: "Last Name *",
            email: "Email Address *",
            phone: "Phone Number *",
            submit: "Send Request",
            privacy: "By submitting this form, you agree to let us contact you to process your reservation.",
            firstNamePlaceholder: "Your first name",
            lastNamePlaceholder: "Your last name",
            emailPlaceholder: "your@email.com",
            phonePlaceholder: "123456789"
          }}
        />
      </div>
    </section>

  </main>
</Layout>

<style>
  .button-story:hover {
    background-color: #402A1E;
    color: white;
    transition: all 0.2s ease-in-out;
  }
</style>