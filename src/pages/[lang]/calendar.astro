---
import Layout from '@/layouts/Layout.astro';
import CalendarContent from '@/components/CalendarContent.astro';
import {
  getLangFromUrl,
  getStaticPaths as getI18nStaticPaths,
} from '@/i18n/utils';

export const prerender = true;
export const getStaticPaths = getI18nStaticPaths;
const lang = getLangFromUrl(Astro.url);
---

<Layout
  title={lang === 'en'
    ? 'Retreat Calendar - Casa del Jaguar'
    : 'Calendario de Retiros - Casa del Jaguar'}
  description={lang === 'en'
    ? 'Plan your 7-day, 6-night ayahuasca retreat in Iquitos. Choose your preferred dates and check availability with our team.'
    : 'Planifica tu retiro de ayahuasca de 7 días y 6 noches en Iquitos. Elige tus fechas preferidas y consulta disponibilidad con nuestro equipo.'}
  keywords={lang === 'en'
    ? 'retreat calendar, ayahuasca retreat dates, Iquitos, Casa del Jaguar, 7 days 6 nights'
    : 'calendario retiros, fechas retiro ayahuasca, Iquitos, Casa del Jaguar, 7 días 6 noches'}
>
  <CalendarContent lang={lang} />
</Layout>
