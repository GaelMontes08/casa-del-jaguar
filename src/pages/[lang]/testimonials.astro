---
import Layout from '@/layouts/Layout.astro';
import { useTranslations, getStaticPaths } from '@/i18n/utils';
import GoogleReviews from '@/components/GoogleReviews.astro';
import { reviewsFor } from '@/data/reviews';

export { getStaticPaths };
export const prerender = true;

const { lang } = Astro.params as { lang: 'en' };
const t = useTranslations(lang);
---

<Layout
  title={t('testimonials.title')}
  description={t('testimonials.subtitle')}
  keywords={t('testimonials.keywords')}
>
  <section class="hero relative min-h-[28rem] -mt-16 pt-24 pb-12 flex items-center justify-center">
    <div class="absolute inset-0 z-0">
      <img
        src="/img/centro-pasadiso.webp" width="1448" height="1086"
        alt="Casa del Jaguar in Iquitos"
        class="w-full h-full object-cover"
      />
      <div class="photo-scrim" aria-hidden="true"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 md:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-bold text-white font-georgia mb-6">Google reviews</h1>
      <p class="text-xl text-white font-gotham max-w-3xl mx-auto">
        These reviews were copied by hand from Google. The original wording stays as the guest wrote it. If it is not in English, a translation is underneath.
      </p>
    </div>
  </section>
  <section class="py-20 bg-white">
    <div class="max-w-[1500px] mx-auto px-4 md:px-8">
      <GoogleReviews
        title="What they wrote"
        note="This is not a Google widget. It is a copy of reviews the center kept."
        reviews={reviewsFor('en')}
      />
    </div>
  </section>
</Layout>
