---
import Layout from '../../layouts/Layout.astro';
import BookingForm from '../../components/BookingForm.astro';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
  ];
}

export const prerender = true;

const { lang } = Astro.params as { lang: "en" | "es" };
const t = useTranslations(lang);

const pageTitle = lang === 'en' 
  ? "Health application - Casa del Jaguar"
  : "Solicitud de salud - Casa del Jaguar";

const pageDescription = lang === 'en'
  ? "Health application for the 7-day, 6-night retreat at Casa del Jaguar in Iquitos. $2,800 USD. The place is confirmed after we read your answers."
  : "Solicitud de salud para el retiro de 7 días y 6 noches en Casa del Jaguar, Iquitos. $2,800 USD.";

const pageKeywords = lang === 'en'
  ? "book ayahuasca retreat, booking Casa del Jaguar, ancestral medicine Peru, spiritual retreat booking"
  : "reservar retiro ayahuasca, reserva Casa del Jaguar, medicina ancestral Peru, reservar retiro espiritual";

const formLabels = lang === 'en' ? {
  firstName: "First Name *",
  lastName: "Last Name *", 
  email: "Email Address *",
  phone: "Phone Number *",
  submit: "Send application",
  privacy: "By sending this form, you agree that we may contact you about your application. A place is not confirmed until we write back.",
  firstNamePlaceholder: "Your first name",
  lastNamePlaceholder: "Your last name",
  emailPlaceholder: "your@email.com",
  phonePlaceholder: "123456789"
} : {
  firstName: "Nombre *",
  lastName: "Apellido *", 
  email: "Correo electrónico *",
  phone: "Número de teléfono *",
  submit: "Solicitar Reserva",
  privacy: "Al enviar este formulario, aceptas que nos pongamos en contacto contigo para procesar tu reserva.",
  firstNamePlaceholder: "Tu nombre",
  lastNamePlaceholder: "Tu apellido",
  emailPlaceholder: "tu@email.com",
  phonePlaceholder: "123456789"
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <main class="min-h-screen bg-[#fffcf6] py-20">
    <div class="max-w-4xl mx-auto px-4">
      <BookingForm 
        title={lang === 'en' ? "Health application" : "Solicitud de salud"}
        subtitle={lang === 'en' 
          ? "7 days and 6 nights, $2,800 USD. The place is confirmed after we read this application. The $100 USD deposit is refunded if the ceremony is not safe for you."
          : "7 días y 6 noches, $2,800 USD. La plaza se confirma después de leer esta solicitud. El depósito es de $100 USD y se devuelve si la ceremonia no es segura para ti."
        }
        buttonText={lang === 'en' ? "Send application" : "Enviar solicitud"}
        showPayPal={true}
        labels={formLabels}
      />
    </div>
  </main>
</Layout>
