---
import Layout from '@/layouts/Layout.astro';
import AnswerBlocks from '@/components/AnswerBlocks.astro';
import { answerBlocks } from '@/data/answers';
import PolicyArticle from '@/components/PolicyArticle.astro';
import { policies } from '@/data/policies';
import { getStaticPaths } from '@/i18n/utils';

export { getStaticPaths };
export const prerender = true;

const page = policies.en.diet;
---

<Layout title={`${page.title} | Casa del Jaguar`} description={page.description} keywords="ayahuasca diet, retreat preparation Iquitos, Casa del Jaguar">
  <main class="bg-[#fffcf6] -mt-16 pt-24">
    <PolicyArticle page={page} />
    <AnswerBlocks items={[...answerBlocks.en.diet]} />
  </main>
</Layout>
