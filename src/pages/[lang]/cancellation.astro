---
import Layout from '@/layouts/Layout.astro';
import PolicyArticle from '@/components/PolicyArticle.astro';
import { policies } from '@/data/policies';
import { getStaticPaths } from '@/i18n/utils';

export { getStaticPaths };
export const prerender = true;

const page = policies.en.cancellation;
---

<Layout title={`${page.title} | Casa del Jaguar`} description={page.description} keywords="ayahuasca retreat cancellation, Casa del Jaguar price, deposit">
  <main class="bg-[#fffcf6] -mt-16 pt-24">
    <PolicyArticle page={page} />
  </main>
</Layout>
