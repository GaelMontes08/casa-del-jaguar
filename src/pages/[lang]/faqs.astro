---
import Layout from '@/layouts/Layout.astro';
import FaqList from '@/components/FaqList.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
  ];
}

export const prerender = true;

const { lang } = Astro.params as { lang: 'en' };

const pageTitle = "Frequently Asked Questions - Casa del Jaguar | Ayahuasca Retreat";
const pageDescription = "Find answers to the most frequently asked questions about our ayahuasca retreats, ceremonies, preparation, safety and bookings at Casa del Jaguar.";
const pageKeywords = "ayahuasca FAQ, ayahuasca retreat questions, Casa del Jaguar FAQ, ayahuasca ceremony doubts, ayahuasca preparation";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  
  <section class="relative min-h-[28rem] flex items-center justify-center -mt-16 pt-24 pb-12">
    <div class="absolute inset-0 z-0">
        <img 
            src="/img/centro-pasadiso.webp" 
            alt="Casa del Jaguar retreat centre"
            width="1448"
            height="1086"
            class="w-full h-full object-cover"
        />
    <div class="photo-scrim" aria-hidden="true"></div>
    </div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 font-georgia">
        Frequently Asked Questions
      </h1>
      <p class="text-xl md:text-2xl mb-8 leading-relaxed font-gotham">
        Answers to the most common questions about our ancestral medicine retreats and ayahuasca ceremonies.
      </p>
    </div>
  </section>

  <main>
    <section class="py-16 bg-white">
      <div class="w-full max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <FaqList lang={lang} />

        <div class="text-center bg-gradient-to-br from-[#D99D55] to-[#B8854A] rounded-lg p-8">
          <h2 class="text-2xl font-bold text-white mb-4 font-georgia">
            Have more questions?
          </h2>
          <p class="text-white/90 mb-6 font-gotham">
            Our team is available to resolve all your doubts and accompany you in this transformation process.
          </p>
          <a href="/en/contact/" class="inline-block bg-white text-[#B8854A] font-semibold py-3 px-8 rounded-lg hover:bg-gray-100 transition-colors font-gotham">
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>

</Layout>
