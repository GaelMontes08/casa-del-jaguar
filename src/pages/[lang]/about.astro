---
import Layout from '@/layouts/Layout.astro';
import AnswerBlocks from '@/components/AnswerBlocks.astro';
import { answerBlocks } from '@/data/answers';
import { useTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } }
  ];
}

export const prerender = true;

const { lang } = Astro.params as { lang: 'es' | 'en' };
const t = useTranslations(lang);

const pageTitle = lang === 'en' 
  ? "About Us - Traditional Amazonian Medicine | Casa del Jaguar"
  : "Nosotros - Medicina Tradicional Amazónica | Casa del Jaguar";

const pageDescription = lang === 'en'
  ? "Learn about Casa del Jaguar's mission, philosophy and experienced masters. Guardians of Amazonian ancestral medicine sharing sacred wisdom with respect and authenticity."
  : "Conoce la misión, filosofía y maestros experimentados de Casa del Jaguar. Guardianes de la medicina ancestral amazónica compartiendo sabiduría sagrada con respeto y autenticidad.";

const pageKeywords = lang === 'en' 
  ? "About Casa del Jaguar, ayahuasca retreat, shamanic healing, traditional medicine, spiritual growth, Amazonian masters, sacred ceremonies"
  : "Acerca de Casa del Jaguar, retiro ayahuasca, sanación chamánica, medicina tradicional, crecimiento espiritual, maestros amazónicos, ceremonias sagradas";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  
  <section class="relative min-h-[28rem] flex items-center justify-center -mt-16 pt-24 pb-12">
    <div class="absolute inset-0 z-0">
        <img 
            src="/img/centro-pasadiso.webp" width="1448" height="1086" 
            alt="Resort Casa del Jaguar - Centro de medicina ancestral"
            class="w-full h-full object-cover"
        />
    <div class="photo-scrim" aria-hidden="true"></div>
    </div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 scroll-animate font-georgia">
        Casa del Jaguar – Ayahuasca Iquitos
      </h1>
      <p class="text-xl md:text-2xl mb-8 leading-relaxed scroll-animate font-gotham">
        {lang === 'en' 
          ? 'Where ancestral wisdom merges with modern science in the pursuit of physical, mental, and emotional well-being.'
          : 'Donde la sabiduría ancestral se fusiona con la ciencia moderna en la búsqueda del bienestar físico, mental y emocional.'
        }
      </p>
    </div>
  </section>

  <AnswerBlocks items={[...answerBlocks.en.about]} />

  <main>
    <section class="py-16 bg-white scroll-animate">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 font-georgia">
              {lang === 'en' ? 'Our Mission' : 'Nuestra Misión'}
            </h2>
            <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'At Casa del Jaguar we sit with adults who want to work on something personal with ayahuasca: a grief, a habit, a question of direction. This is not medical treatment and it does not replace a psychiatrist.'
                : 'En Casa del Jaguar acompañamos a adultos que quieren trabajar algo personal con la ayahuasca: un duelo, un hábito, una pregunta de dirección. No es un tratamiento médico ni sustituye a un psiquiatra.'
              }
            </p>
            <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
              {lang === 'en'
                ? 'Dan Reynolds founded Casa del Jaguar in 2008 and led the ceremonies until 2014. He died in 2021. Since 2014, Denis Montes has led the ceremonies together with indigenous shamans. Ceremonies are in English, and Denis translates.'
                : 'Dan Reynolds fundó Casa del Jaguar en 2008 y guió las ceremonias hasta 2014. Falleció en 2021. Desde 2014, Denis Montes guía las ceremonias junto con chamanes indígenas. Las ceremonias son en inglés y Denis traduce.'
              }
            </p>
            <p class="text-gray-600 text-lg leading-relaxed font-gotham">
              {lang === 'en'
                ? '**Our mission is simple but profound:** Help people reconnect with their true self, heal past traumas, and unlock their full potential.'
                : '**Nuestra misión es simple pero profunda:** Ayudar a las personas a reconectarse con su verdadero ser, sanar traumas del pasado y liberar todo su potencial.'
              }
            </p>
          </div>
          <div class="bg-gradient-to-br from-[#D99D55] to-[#B8854A] p-8 rounded-lg text-white">
            <h3 class="text-xl font-semibold mb-4 font-georgia">
              {lang === 'en' ? 'Our Approach' : 'Nuestro Enfoque'}
            </h3>
            <ul class="space-y-3 text-white/90 font-gotham">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                {lang === 'en' ? 'Maximum respect and ceremonial seriousness' : 'Máximo respeto y seriedad ceremonial'}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                {lang === 'en' ? 'Comprehensive support for participants' : 'Apoyo integral a los participantes'}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                {lang === 'en' ? 'Fusion of ancestral wisdom and science' : 'Fusión de sabiduría ancestral y ciencia'}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                {lang === 'en' ? 'Inner transformation and deep healing' : 'Transformación interior y sanación profunda'}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                {lang === 'en' ? 'Not tourism, but authentic healing' : 'No turismo, sino sanación auténtica'}
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-[#fffcf6] scroll-animate">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12 font-georgia">
          {lang === 'en' ? 'Our Journey' : 'Nuestro Camino'}
        </h2>
        <div class="max-w-4xl mx-auto">
          <div class="bg-white p-8 rounded-lg shadow-lg mb-8">
            <h3 class="text-2xl font-semibold mb-4 text-gray-900 font-georgia">
              {lang === 'en' ? 'Since 2008' : 'Desde 2008'}
            </h3>
            <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'Dan Reynolds founded the centre in 2008 and led the ceremonies from 2008 to 2014. He died in 2021. Since 2014, Maestro Denis Montes has led the ceremonies together with indigenous shamans.'
                : 'Dan Reynolds fundó la casa en 2008 y guió las ceremonias de 2008 a 2014. Falleció en 2021. Desde 2014, el Maestro Denis Montes guía las ceremonias junto con chamanes indígenas.'
              }
            </p>
            <p class="text-gray-600 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'For us, the master plants Ayahuasca and Huachuma are not just plants: they are a powerful tool for inner transformation and healing.'
                : 'Para nosotros, las plantas maestras Ayahuasca y la Huachuma no son solo plantas: son una poderosa herramienta para la transformación interior y la sanación.'
              }
            </p>
          </div>
          
          <div class="bg-white p-8 rounded-lg shadow-lg">
            <h3 class="text-2xl font-semibold mb-4 text-gray-900 font-georgia">
              {lang === 'en' ? 'Sacred Ceremonies' : 'Ceremonias Sagradas'}
            </h3>
            <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'Our shamanic ceremonies are conducted with great respect and above all providing all necessary support to the participants; we honor the sacred nature of the ceremony and the medicine.'
                : 'Nuestras ceremonias chamánicas se llevan a cabo con mucho respeto y sobre todo brindando todo el apoyo necesario a los participantes; honramos lo sagrado de la ceremonia y la medicina.'
              }
            </p>
            <p class="text-gray-600 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'In this way, the ceremonial maloca is transformed into a space of deep healing, where we combine the wisdom of master plants with the knowledge of modern science.'
                : 'De esta manera la maloca ceremonial se transforma en un espacio de sanación profunda, donde combinamos la sabiduría de las plantas maestras con los conocimientos de la ciencia moderna.'
              }
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-brand-light scroll-animate">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12 font-georgia">
            {lang === 'en' ? 'Master Denis Montes' : 'Maestro Denis Montes'}
          </h2>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-12">
            <div class="text-center">
              <img src="/img/maestro-chaman-denis-montes.webp" width="800" height="618" alt="Maestro Denis Montes" class="mx-auto mb-6 h-64 w-64 rounded-full object-cover" />
            </div>
            
            <div>
              <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
                {lang === 'en' 
                  ? 'Denis Montes was born in Iquitos in 1983. He is a chemical engineer and a member of the Colegio de Ingenieros del Perú (CIP No. 271557).'
                  : 'Denis Montes nació en Iquitos en 1983. Es ingeniero químico y miembro del Colegio de Ingenieros del Perú (CIP N° 271557).'
                }
              </p>
              <p class="text-gray-600 mb-4 text-lg leading-relaxed font-gotham">
                {lang === 'en' 
                  ? 'He has practiced his profession for many years in cities like Iquitos and Lima, as well as in rural jungle areas, including places like Contamana, Atalaya, Yarinacocha, among others.'
                  : 'Ha ejercido su profesión durante muchos años en ciudades como Iquitos y Lima, así como en zonas rurales de la selva, incluyendo lugares como Contamana, Atalaya, Yarinacocha, entre otros.'
                }
              </p>
              <p class="text-gray-600 text-lg leading-relaxed font-gotham">
                {lang === 'en' 
                  ? 'His first encounter with Mother Ayahuasca was at age 16 while working as an Official Tourist Guide.'
                  : 'Su primer encuentro con la Madre Ayahuasca fue a los 16 años mientras trabajaba como Guía Turístico Oficial.'
                }
              </p>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div class="bg-white p-6 rounded-lg shadow-lg">
              <h3 class="text-xl font-semibold mb-4 text-gray-900 font-georgia">
                {lang === 'en' ? 'Academic Formation' : 'Formación Académica'}
              </h3>
              <ul class="space-y-2 text-gray-600 font-gotham">
                <li>• {lang === 'en' ? 'National University of the Peruvian Amazon (UNAP)' : 'Universidad Nacional de la Amazonía Peruana (UNAP)'}</li>
                <li>• {lang === 'en' ? 'College of Engineers of Peru: CIP N° 271557' : 'Colegio de Ingenieros del Perú: CIP N° 271557'}</li>
                <li>• CEVATUR PERU</li>
                <li>• IDAT</li>
                <li>• ESAN University</li>
                <li>• SEGEL</li>
              </ul>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-lg">
              <h3 class="text-xl font-semibold mb-4 text-gray-900 font-georgia">
                {lang === 'en' ? 'Shamanic Path' : 'Camino Chamánico'}
              </h3>
              <p class="text-gray-600 mb-3 leading-relaxed font-gotham">
                {lang === 'en' 
                  ? 'Denis met Dan Reynolds in 2011, while Dan was leading the ceremonies. Since 2014, Denis has led them together with indigenous shamans. They are in English, and Denis translates.'
                  : 'Denis conoció a Dan Reynolds en 2011, mientras Dan guiaba las ceremonias. Desde 2014, Denis las guía junto con chamanes indígenas. Son en inglés, y Denis traduce.'
                }
              </p>
              <p class="text-gray-600 leading-relaxed font-gotham">
                {lang === 'en' 
                  ? 'Places where he lived with indigenous peoples who enriched his experience and knowledge of Amazonian biodiversity.'
                  : 'Lugares donde convivió con pueblos indígenas que enriquecieron su experiencia y conocimiento de la biodiversidad amazónica.'
                }
              </p>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-[#D99D55] to-[#B8854A] p-8 rounded-lg text-white text-center">
            <h3 class="text-2xl font-semibold mb-4 font-georgia">
              {lang === 'en' ? 'His Mission' : 'Su Misión'}
            </h3>
            <p class="text-white/90 text-lg leading-relaxed font-gotham">
              {lang === 'en' 
                ? 'He advocates for Ayahuasca to be known by all, as it is a sacred medicine used by our ancestors, and modern medicine is discovering its benefits for our physical, mental, and spiritual health.'
                : 'Aboga por que la Ayahuasca sea conocida por todos, ya que es una medicina sagrada utilizada por nuestros antepasados, y la medicina moderna está descubriendo sus beneficios para nuestra salud física, mental y espiritual.'
              }
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white scroll-animate">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8 font-georgia">
            {lang === 'en' ? 'Who We Are Here For' : 'Para Quién Estamos Aquí'}
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed font-gotham">
            {lang === 'en' 
              ? 'Groups are 8 people at most. The retreat is 7 days and 6 nights and costs $2,800 USD, the same price for every room.'
              : 'El grupo es de máximo 8 personas. El retiro dura 7 días y 6 noches y cuesta $2,800 USD, el mismo precio para todas las habitaciones.'
            }
          </p>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed font-gotham">
            {lang === 'en' 
              ? 'We do not view shamanic healing ceremonies as simple tourist attractions; we carry out our work with maximum respect and seriousness.'
              : 'Nosotros no vemos a las ceremonias de sanación chamánica como simples atracciones turísticas, realizamos nuestro trabajo con el máximo respeto y seriedad.'
            }
          </p>
          <p class="text-lg text-gray-600 leading-relaxed font-gotham">
            {lang === 'en' 
              ? '**We know that healing is a process**, which is why we combine the wisdom of master plants with the knowledge of modern science to create a space of authentic and profound transformation.'
              : '**Sabemos que la sanación es un proceso**, por eso combinamos la sabiduría de las plantas maestras con los conocimientos de la ciencia moderna para crear un espacio de transformación auténtica y profunda.'
            }
          </p>
        </div>
      </div>
    </section>
  </main>

</Layout>

<style>
  .scroll-animate {
    transition: all 0.4s ease;
  }
  
  .scroll-animate.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  const animatedElements = document.querySelectorAll('.scroll-animate');
  animatedElements.forEach(el => observer.observe(el));
});
</script>
