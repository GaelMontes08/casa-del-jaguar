---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import ImageSlider from '@/components/ImageSlider.astro';
import GoogleReviews from '@/components/GoogleReviews.astro';
import { reviewsFor } from '@/data/reviews';
import { useTranslations } from '@/i18n/utils';
import BookingForm from '@/components/BookingForm.astro';
import Services from '@/components/Services.astro';
import LocationClarity from '@/components/LocationClarity.astro';
import ValueOffer from '@/components/ValueOffer.astro';

export const prerender = true;

const t = useTranslations('es');
---

<Layout title={t('home.title')} description={t('home.subtitle')} keywords="medicina ancestral, ayahuasca, retiro, Iquitos, Amazonía, sanación, transformación, Casa del Jaguar, ceremonias ayahuasca Iquitos">
  
  <Hero />
  <main>
    <section class="py-20 bg-gradient-to-b from-brand-cream to-white">
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl lg:max-w-5xl mb-16 text-center lg:text-left">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark mb-8 font-georgia leading-tight">
            Un retiro de 7 días en <span class="text-brand-gold">Iquitos</span>
          </h2>
          
          <p class="text-[19px] md:text-md text-brand-dark mb-4 font-gotham leading-relaxed">
            Casa del Jaguar es un retiro de ayahuasca de 7 días y 6 noches en la ciudad de Iquitos. Trabaja aquí desde 2009. El precio es $2,800 USD y el grupo es de máximo 8 personas.
          </p>
          
          <p class="text-[19px] md:text-md text-brand-dark font-gotham leading-relaxed mb-12">
            Las ceremonias son en la maloca, en la ciudad, a minutos del aeropuerto. Las guían chamanes indígenas junto con el Maestro Denis Montes. Denis dirige el programa. Las ceremonias son en inglés y Denis traduce. En los días de integración hay dos salidas a la Amazonía.
          </p>
        </div>
        
        <p class="font-gotham text-brand-dark">Dan Reynolds fundó Casa del Jaguar en 2009 y guió las ceremonias hasta 2014. Desde 2014 las guía Denis Montes. El retiro cuesta $2,800 USD, con el mismo precio para todas las habitaciones.</p>
      </div>
    </section>

    <section class="pt-15 md:py-15 bg-gradient-to-r from-[#fdf6e7] to-[#fdf9f1] relative overflow-hidden scroll-animate">
      <div class="absolute top-1/2 left-0 w-[600px] h-[600px] bg-gradient-to-br from-[#F2CF8D] to-[#ffefbb] rounded-full transform -translate-x-[20px] -translate-y-[800px] md:translate-x-[610px] md:-translate-y-[500px]"></div>
      
      <div class="max-w-[1500px] mx-auto flex flex-col md:flex-row items-end gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 flex justify-end items-end order-2 md:order-1">
          <img src="/img/maestro-chaman-denis-montes.webp" width="800" height="618" alt="Maestro Chaman Denis Montes" class="w-full h-[500px] object-cover transform md:translate-y-[60px]" loading="lazy" />
        </div>
        <div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left order-1 md:order-2">
          <blockquote class="text-2xl md:text-4xl font-georgia text-brand-dark mb-6 font-semibold leading-snug">
            “Vine a esta medicina buscando alivio. Hoy acompaño a otras personas con el mismo cuidado con el que a mí me acompañaron.”
          </blockquote>
          <div class="text-brand-dark text-base md:text-lg font-gotham mb-8 opacity-70">
            Denis Montes nació en Iquitos en 1983. Es ingeniero químico. Guía las ceremonias desde 2014, junto con chamanes indígenas.
          </div>
          <div class="text-sm text-brand-dark opacity-60 mb-8 font-gotham">
            — Denis Montes. Guía las ceremonias desde 2014.
          </div>
          <a href="/about" class="button-story inline-block bg-brand-gold text-brand-dark px-8 py-3 rounded-full font-bold text-lg shadow-lg font-gotham uppercase tracking-wide hover:scale-110 transition-all">
            Nuestra Historia
          </a>
        </div>
      </div>
    </section>

    <section class="pt-20 md:py-20 bg-gradient-to-l from-[#fdf6e7] to-[#fdf9f1] scroll-animate relative overflow-hidden">
      
      <div class="absolute top-1/2 right-0 w-[600px] h-[600px] bg-gradient-to-br from-[#F2CF8D] to-[#ffefbb] rounded-full transform -translate-x-[20px] -translate-y-[800px] md:-translate-x-[150px] md:-translate-y-[220px]"></div>

      <div class="max-w-[1500px] mx-auto flex flex-col md:flex-row items-center gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 space-y-8">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark font-georgia leading-tight">
            Sana tu <span class="text-brand-gold">mente</span>, <span class="text-brand-gold">cuerpo</span> y <span class="text-brand-gold">alma</span>
          </h2>
          
          <div class="text-lg md:text-[19px] text-brand-dark font-gotham leading-relaxed space-y-4">
            <p>
              Nuestro programa está diseñado para <strong>acelerar el autodescubrimiento</strong> y proporcionar a los huéspedes las herramientas necesarias para comprender e integrar sus experiencias transformadoras.
            </p>
            
            <p>
              Entre una ceremonia y la siguiente hay <strong>yoga, respiración, meditación y Hemi-Sync</strong>, un audio grabado para concentrarse en silencio, además de talleres de integración.
            </p>

            <p class="text-base opacity-70">
              Nuestros retiros se realizan regularmente, ofreciendo flexibilidad para que puedas unirte cuando mejor se adapte a tu horario.
            </p>
          </div>
          
          <div class="pt-4">
            <a href="/casa-del-jaguar-way" class="inline-block bg-brand-dark text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl font-gotham uppercase tracking-wide hover:bg-brand-gold hover:text-brand-dark transition-all duration-300 transform hover:scale-105">
              Descubre el Camino
            </a>
          </div>
        </div>
        
        <div class="w-full md:w-1/2 flex justify-center">
          <img src="/img/ayahuasca-cabeza-clava.webp" width="960" height="640" alt="Medicina Ancestral - Cabeza Clava" class="w-full max-w-lg md:h-[600px] object-cover rounded-md shadow-black shadow-lg" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="py-20 bg-gradient-to-r from-[#fdf6e7] to-[#fdf9f1] scroll-animate relative overflow-hidden">
      
      <div class="absolute top-1/2 left-0 w-[600px] h-[600px] bg-gradient-to-bl from-[#F2CF8D] to-[#ffefbb] rounded-full transform translate-x-[20px] -translate-y-[800px] md:translate-x-[150px] md:-translate-y-[250px]"></div>
      
      <div class="max-w-[1500px] mx-auto flex flex-col md:flex-row items-center gap-16 px-4 md:px-8 relative z-10">
        <div class="w-full md:w-1/2 flex justify-center order-2 md:order-1">
          <img src="/img/maloca-ceremonial.webp" width="942" height="628" alt="Maloca Ceremonial - Casa del Jaguar" class="w-full max-w-lg md:h-[600px] object-cover rounded-md shadow-black shadow-lg" loading="lazy" />
        </div>
        
        <div class="w-full md:w-1/2 space-y-8 order-1 md:order-2">
          <h2 class="text-4xl md:text-5xl font-bold text-brand-dark font-georgia leading-tight">
            Un <span class="text-brand-gold">santuario</span> urbano en <span class="text-brand-gold">Iquitos</span>
          </h2>
          
          <div class="text-lg md:text-[19px] text-brand-dark font-gotham leading-relaxed space-y-4">
            <p>
              Nuestro centro está diseñado como un <strong>santuario sagrado</strong> dentro de la ciudad de Iquitos, donde la comodidad, la seguridad y la tradición se encuentran para crear el ambiente ideal para tu transformación personal.
            </p>
            
            <p>
              La <strong>Maloca ceremonial</strong> es el corazón espiritual de Casa del Jaguar, un espacio sagrado construido con materiales naturales donde se realizan las ceremonias de medicina ancestral bajo la guía de nuestros maestros experimentados.
            </p>
            
            <p class="text-base opacity-70">
              Alojamiento exclusivo, gastronomía consciente, atención médica a minutos y excursiones opcionales a la selva en tus días de integración.
            </p>
          </div>
          
          <div class="pt-4">
            <a href="/resort" class="inline-block bg-brand-dark text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl font-gotham uppercase tracking-wide hover:bg-brand-gold hover:text-brand-dark transition-all duration-300 transform hover:scale-105">
              Conoce el Resort
            </a>
          </div>
        </div>
      </div>
    </section>

    <Services showCta={true} />

    <LocationClarity />

    <ValueOffer />

    <section class="scroll-animate">
        <ImageSlider 
          images={[
            { src: '/img/centro-maloca.webp', alt: 'Centro Maloca - Casa del Jaguar' },
            { src: '/img/centro-pasadiso.webp', alt: 'Centro Paraíso - Casa del Jaguar' },
            { src: '/img/centro-pileta.webp', alt: 'Centro Pileta - Casa del Jaguar' },
            { src: '/img/centro-sala.webp', alt: 'Centro Sala - Casa del Jaguar' },
            { src: '/img/maloca-ceremonial.webp', alt: 'Maloca Ceremonial - Casa del Jaguar' }
          ]}
          autoplay={true}
          autoplayDelay={5000}
        />
    </section>

    <section class="py-20 bg-white scroll-animate">
      <div class="max-w-[1500px] mx-auto px-4 md:px-8">
        <GoogleReviews
          title="Reseñas de Google"
          note="Textos copiados a mano desde reseñas de Google. Se muestra el idioma original y, si hace falta, una traducción."
          reviews={reviewsFor('es')}
          autoplay={true}
          autoplayDelay={7000}
        />
      </div>
    </section>

    <section class="py-20 bg-brand-cream scroll-animate">
      <div class="max-w-[1500px] mx-auto px-4 md:px-8">
        <BookingForm 
          title="Solicitud de salud"
          subtitle="La plaza se confirma después de leer tus respuestas. El depósito de $100 USD se devuelve si la ceremonia no es segura para ti."
          labels={{
            firstName: "Nombre *",
            lastName: "Apellido *",
            email: "Correo electrónico *",
            phone: "Número de teléfono *",
            submit: "Enviar solicitud",
            privacy: "Al enviar este formulario, aceptas que nos pongamos en contacto contigo para procesar tu reserva.",
            firstNamePlaceholder: "Tu nombre",
            lastNamePlaceholder: "Tu apellido",
            emailPlaceholder: "tu@email.com",
            phonePlaceholder: "123456789"
          }}
        />
      </div>
    </section>

  </main>
</Layout>

<style>
  .button-story:hover {
    background-color: #402A1E;
    color: white;
    transition: all 0.2s ease-in-out;
  }
</style>